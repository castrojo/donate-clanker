# 61-donate-clanker.just — the file an eventual image build would ship at
# /usr/share/ublue-os/just/61-donate-clanker.just (not done yet — see below).
#
# This is the ONLY file that ships/installs. Everything donate-clanker needs
# (quadlet unit content, per-tool fragments, host CLI detection) is embedded
# below as private (_-prefixed) recipes and variables, on purpose: a user
# browsing the image or this repo should find one just-recipe file and the
# three public commands it exposes, not a scattered bin/ of standalone
# scripts they might stumble into and run directly out of context.
#
# quadlet/*.conf in this repo are the human-editable *source* for the
# strings embedded below — if you change one, copy the change into the
# matching variable/case arm here too. They are not read at runtime.
#
# Bluefin's root Justfile (/usr/share/ublue-os/just/00-entry.just) imports a
# fixed list of files, NOT a glob. Getting this file under
# /usr/share/ublue-os/just/ so plain 'ujust donate-clanker' works
# system-wide means baking it into a custom image build (out of scope here
# — see README "Scope").
#
# For local/personal use right now, run this file directly with plain
# 'just --justfile', or import it from your own personal Justfile — see
# README "Installing this into your own setup" for the copy-paste
# commands. All state this recipe touches lives under $HOME (quadlets,
# config, workspace) — nothing here needs root or writes elsewhere.

# Deterministic detection/fallback order for TOOL auto-detect.
tool_order := "claude copilot goose codex"

# TOOL/CLANKER_SRC are read from the environment (like upstream hive's own
# Justfile does with HIVE_HUB) so 'TOOL=copilot ujust donate-clanker' works
# as documented — 'just' recipe parameters are positional, not KEY=VALUE,
# so these can't be plain recipe params.
tool_env := env("TOOL", "")
clanker_src_env := env("CLANKER_SRC", "")

# Base quadlet unit — no [Install] section (see comment at the bottom of it).
# Mirrors quadlet/donate-clanker.container in this repo.
donate_clanker_unit := '''
# donate-clanker.container — Podman Quadlet for the KubeStellar Hive
# contributor workload (ghcr.io/kubestellar/hive-contributor:latest).
# Generated by 'ujust donate-clanker' — do not hand-edit, edit the Justfile
# that generated it instead.

[Unit]
Description=Donate a Clanker — Hive contributor workload (foreground only)
# No Wants=/After=default.target: this unit must never be pulled in by a
# normal boot/login target. It only exists while explicitly started.

[Container]
Image=ghcr.io/kubestellar/hive-contributor:latest
ContainerName=donate-clanker
UserNS=keep-id

# Sandboxed rootless network by default (not upstream's --network host,
# which isn't explained anywhere and isn't needed for an outbound-only
# WebSocket relay). Switch back via a drop-in if you hit connectivity
# issues reaching a local LiteLLM/Ollama endpoint.
# Network=host

Volume=%h/.config/hive:/home/dev/.config/hive:ro,Z
Volume=%h/.config/gh:/home/dev/.config/gh:ro,Z

# ASSUMPTION: no upstream equivalent — convenience workspace mount resolved
# by the TOOL/CLANKER_SRC logic below, not something the hive-contributor
# image documents needing.
Volume=%h/.local/state/donate-clanker/workspace:/home/dev/workspace:Z

EnvironmentFile=%h/.config/donate-clanker/contributor.env
EnvironmentFile=%h/.config/donate-clanker/secrets.env

[Service]
TimeoutStopSec=20

# Intentionally NO [Install] section — see README "Foreground-only". This
# unit must only ever run because a human just typed 'ujust donate-clanker'
# in a terminal they're watching, never because systemd started it for them.
'''

# Shared bash, 'eval''d at the top of every recipe script that needs it:
# host CLI detection + the per-tool quadlet fragment text. Keeping this in
# one place instead of duplicating it per-recipe is the only concession to
# DRY here — it never leaves the Justfile as a file of its own.
shared_functions := '''
tool_installed() {
  case "$1" in
    claude)  command -v claude &>/dev/null ;;
    copilot) command -v gh &>/dev/null ;;
    goose)   command -v goose &>/dev/null ;;
    codex)   command -v codex &>/dev/null ;;
    *)       return 1 ;;
  esac
}
tool_authenticated() {
  case "$1" in
    claude)  [[ -d "${HOME}/.claude" || -f "${HOME}/.claude.json" ]] ;;
    copilot) gh auth status &>/dev/null ;;
    goose)   [[ -n "${GOOSE_PROVIDER:-}" || -f "${HOME}/.config/goose/config.yaml" ]] ;;
    codex)   [[ -n "${OPENAI_API_KEY:-}" || -d "${HOME}/.codex" ]] ;;
    *)       return 1 ;;
  esac
}
tool_fixit_hint() {
  case "$1" in
    claude)  echo "Run: claude   (then type /login and follow the prompts)" ;;
    copilot) echo "Run: gh auth login --web --scopes repo,read:org" ;;
    goose)   echo "Run: goose configure   (or: export GOOSE_PROVIDER=... GOOSE_MODEL=...)" ;;
    codex)   echo "Run: codex login   (or: export OPENAI_API_KEY=...)" ;;
    *)       echo "Unknown tool: $1" ;;
  esac
}
tool_install_hint() {
  case "$1" in
    claude)  echo "Install: npm i -g @anthropic-ai/claude-code" ;;
    copilot) echo "Install: see https://cli.github.com" ;;
    goose)   echo "Install: https://github.com/block/goose/releases" ;;
    codex)   echo "Install: npm i -g @openai/codex" ;;
    *)       echo "" ;;
  esac
}
tool_host_dirs() {
  # Host-side paths each tool_fragment_conf bind-mounts. Podman/quadlet does
  # NOT create missing bind-mount sources — it fails the container start
  # with "no such file or directory" — so these must exist before the unit
  # starts. One path per line (no spaces expected in $HOME on supported hosts).
  case "$1" in
    claude)  printf '%s\n' "${HOME}/.claude" "${HOME}/.config/claude-code" ;;
    copilot) ;;
    goose)   printf '%s\n' "${HOME}/.config/goose" ;;
    codex)   printf '%s\n' "${HOME}/.codex" ;;
    *)       return 1 ;;
  esac
}
copilot_live_models() {
  # Queries the same model-listing endpoint the Copilot CLI/extensions use,
  # so the picker always reflects what's actually available to this
  # account today rather than a list baked into this file that goes stale.
  # Best-effort: any missing dependency or request failure just returns
  # non-zero so the caller can fall back to free-text input.
  command -v curl &>/dev/null && command -v jq &>/dev/null && command -v gh &>/dev/null || return 1
  local tok
  tok="$(gh auth token 2>/dev/null)" || return 1
  [[ -n "$tok" ]] || return 1
  curl -fsS --max-time 5 \
    -H "Authorization: Bearer ${tok}" \
    -H "Editor-Version: donate-clanker/1.0" \
    -H "Copilot-Integration-Id: vscode-chat" \
    https://api.githubcopilot.com/models 2>/dev/null \
    | jq -r '.data[]? | select(.model_picker_enabled == true and .capabilities.type == "chat") | .id' 2>/dev/null
}
tool_fragment_conf() {
  # Mirrors quadlet/tools/<name>.conf in this repo.
  case "$1" in
    claude)
      cat <<'FRAG'
[Container]
Environment=AGENT_BACKEND=claude
Volume=%h/.claude:/home/dev/.claude:Z
Volume=%h/.config/claude-code:/home/dev/.config/claude-code:Z
FRAG
      ;;
    copilot)
      cat <<'FRAG'
[Container]
Environment=AGENT_BACKEND=copilot
FRAG
      ;;
    goose)
      cat <<'FRAG'
[Container]
Environment=AGENT_BACKEND=goose
Volume=%h/.config/goose:/home/dev/.config/goose:Z
FRAG
      ;;
    codex)
      cat <<'FRAG'
[Container]
Environment=AGENT_BACKEND=codex
Volume=%h/.codex:/home/dev/.codex:Z
FRAG
      ;;
    *)
      echo "ERROR: no fragment for tool '$1'" >&2
      return 1
      ;;
  esac
}
'''

# Start donating clanker cycles to the hive — foreground, Ctrl-C to stop.
# TOOL defaults to auto-detect: the first installed+authenticated CLI, in
# order (claude, copilot, goose, codex).
# Usage: ujust donate-clanker
#        TOOL=copilot ujust donate-clanker
#        CLANKER_SRC=~/src/some-repo ujust donate-clanker
#        CLANKER_SRC=https://github.com/org/repo ujust donate-clanker
donate-clanker:
    #!/usr/bin/env bash
    set -euo pipefail
    {{shared_functions}}
    TOOL_ORDER="{{tool_order}}"
    TOOL="{{tool_env}}"
    CLANKER_SRC="{{clanker_src_env}}"
    # NOT $PWD: just changes the recipe's working directory to wherever the
    # *justfile* lives (e.g. ~ when this is imported from a personal
    # ~/Justfile), not the directory the user actually ran 'just'/'ujust'
    # from. invocation_directory() is just's own builtin for that real cwd.
    INVOKED_DIR="{{invocation_directory()}}"

    STATE_DIR="${HOME}/.local/state/donate-clanker"
    CFG_DIR="${HOME}/.config/donate-clanker"
    CONF_DIR="${HOME}/.config/containers/systemd"
    DROPIN_DIR="${CONF_DIR}/donate-clanker.container.d"
    WORKSPACE="${STATE_DIR}/workspace"
    CLONES_DIR="${STATE_DIR}/clones"
    HIVE_SRC_DIR="${STATE_DIR}/hive-src"
    mkdir -p "${CONF_DIR}" "${DROPIN_DIR}" "${STATE_DIR}" "${CFG_DIR}" "${CLONES_DIR}"

    # Remembers the last TOOL/model choices made through the interactive
    # pickers below, so re-running donate-clanker offers them back as the
    # pre-selected default instead of starting blank every time.
    LAST_FILE="${CFG_DIR}/last-selections.env"
    LAST_TOOL="" LAST_MODEL_CLAUDE="" LAST_MODEL_COPILOT="" LAST_MODEL_CODEX="" LAST_GOOSE_PROVIDER="" LAST_GOOSE_MODEL=""
    [[ -f "$LAST_FILE" ]] && source "$LAST_FILE"

    # ── 0. Pick TOOL: auto-detect; if exactly one CLI is ready, use it
    #      silently; if several are ready, let the user pick with gum
    #      (this is foreground/attended already, so an interactive prompt
    #      here doesn't compromise the "never unattended" guarantee). An
    #      explicit TOOL= always wins and skips detection entirely. ──
    if [[ -z "$TOOL" ]]; then
      READY=()
      for t in ${TOOL_ORDER}; do
        tool_installed "$t" && tool_authenticated "$t" && READY+=("$t")
      done
      case "${#READY[@]}" in
        0)
          echo "ERROR: no supported CLI is installed and authenticated on this host." >&2
          for t in ${TOOL_ORDER}; do echo "  ${t}: $(tool_install_hint "$t")" >&2; done
          echo "Then re-run, or pass explicitly: TOOL=<name> ujust donate-clanker" >&2
          exit 1
          ;;
        1)
          TOOL="${READY[0]}"
          echo "TOOL not set — auto-detected: ${TOOL}"
          ;;
        *)
          if command -v gum &>/dev/null && [[ -t 0 ]]; then
            TOOL="$(printf '%s\n' "${READY[@]}" | gum choose --selected="${LAST_TOOL}" --header "Multiple AI CLIs are ready — pick one:")"
            [[ -n "$TOOL" ]] || { echo "ERROR: no selection made." >&2; exit 1; }
          else
            echo "ERROR: multiple CLIs are ready (${READY[*]}) and 'gum' isn't available to prompt." >&2
            echo "  Install gum, or pass explicitly: TOOL=<name> ujust donate-clanker" >&2
            exit 1
          fi
          ;;
      esac
    else
      if ! tool_installed "$TOOL"; then
        echo "ERROR: TOOL=${TOOL} requested but not installed." >&2
        echo "  $(tool_install_hint "$TOOL")" >&2
        exit 1
      fi
      if ! tool_authenticated "$TOOL"; then
        echo "ERROR: TOOL=${TOOL} is installed but not authenticated." >&2
        echo "  $(tool_fixit_hint "$TOOL")" >&2
        exit 1
      fi
    fi

    # ── 0b. Optional provider/model, only prompted when not already given
    #        via env and a terminal + gum are available. Blank = use the
    #        tool's own default. copilot gets a live model list fetched
    #        from the same API the Copilot CLI/extensions use, so there's
    #        never a model name to remember or mistype; other tools keep
    #        free-text entry. Whatever is chosen (including staying blank)
    #        is remembered as the next run's default. ──
    AGENT_MODEL="${AGENT_MODEL:-}"
    GOOSE_PROVIDER="${GOOSE_PROVIDER:-}"
    GOOSE_MODEL="${GOOSE_MODEL:-}"
    LAST_MODEL_FOR_TOOL=""
    case "$TOOL" in
      claude)  LAST_MODEL_FOR_TOOL="$LAST_MODEL_CLAUDE" ;;
      copilot) LAST_MODEL_FOR_TOOL="$LAST_MODEL_COPILOT" ;;
      codex)   LAST_MODEL_FOR_TOOL="$LAST_MODEL_CODEX" ;;
    esac
    if command -v gum &>/dev/null && [[ -t 0 ]]; then
      if [[ "$TOOL" == "goose" && -z "$GOOSE_PROVIDER" ]]; then
        GOOSE_PROVIDER="$(printf '%s\n' anthropic openai google ollama openrouter | gum choose --selected="${LAST_GOOSE_PROVIDER}" --header "Goose provider (Esc to leave unset — needs 'goose configure' instead):")"
      fi
      if [[ "$TOOL" == "goose" ]]; then
        [[ -z "$GOOSE_MODEL" ]] && GOOSE_MODEL="$(gum input --value "${LAST_GOOSE_MODEL}" --placeholder "e.g. claude-3-5-sonnet — blank for goose's default" --header "Goose model (optional):")"
      elif [[ "$TOOL" == "copilot" && -z "$AGENT_MODEL" ]]; then
        MODEL_LIST="$(copilot_live_models || true)"
        if [[ -n "$MODEL_LIST" ]]; then
          AGENT_MODEL="$(printf '%s\n' "$MODEL_LIST" | gum choose --selected="${LAST_MODEL_FOR_TOOL}" --header "Model for copilot (Esc to leave unset — use copilot's default):")"
        else
          AGENT_MODEL="$(gum input --value "${LAST_MODEL_FOR_TOOL}" --placeholder "e.g. claude-sonnet-4-6 — blank for copilot's default" --header "Model override for copilot (optional — live list unavailable):")"
        fi
      else
        [[ -z "$AGENT_MODEL" ]] && AGENT_MODEL="$(gum input --value "${LAST_MODEL_FOR_TOOL}" --placeholder "e.g. claude-sonnet-4-6 — blank for ${TOOL}'s default" --header "Model override for ${TOOL} (optional):")"
      fi
    fi

    # Persist this run's resolved choices as next run's defaults.
    LAST_TOOL="$TOOL"
    case "$TOOL" in
      claude)  LAST_MODEL_CLAUDE="$AGENT_MODEL" ;;
      copilot) LAST_MODEL_COPILOT="$AGENT_MODEL" ;;
      codex)   LAST_MODEL_CODEX="$AGENT_MODEL" ;;
      goose)   LAST_GOOSE_PROVIDER="$GOOSE_PROVIDER"; LAST_GOOSE_MODEL="$GOOSE_MODEL" ;;
    esac
    {
      printf 'LAST_TOOL=%q\n' "$LAST_TOOL"
      printf 'LAST_MODEL_CLAUDE=%q\n' "$LAST_MODEL_CLAUDE"
      printf 'LAST_MODEL_COPILOT=%q\n' "$LAST_MODEL_COPILOT"
      printf 'LAST_MODEL_CODEX=%q\n' "$LAST_MODEL_CODEX"
      printf 'LAST_GOOSE_PROVIDER=%q\n' "$LAST_GOOSE_PROVIDER"
      printf 'LAST_GOOSE_MODEL=%q\n' "$LAST_GOOSE_MODEL"
    } > "$LAST_FILE"

    # ── 1. Ensure upstream contribute-setup has run ──
    HIVE_CONTRIBUTOR_ENV="${HOME}/.config/hive/contributor.env"
    if [[ ! -f "$HIVE_CONTRIBUTOR_ENV" ]]; then
      echo "Upstream contribute-setup hasn't run yet (no ${HIVE_CONTRIBUTOR_ENV})."
      for cmd in just gh git; do
        command -v "$cmd" &>/dev/null || { echo "ERROR: '${cmd}' is required to run contribute-setup." >&2; exit 1; }
      done
      if [[ -d "${HIVE_SRC_DIR}/.git" ]]; then
        git -C "$HIVE_SRC_DIR" pull --ff-only --quiet || echo "WARNING: pull failed, using existing checkout"
      else
        echo "Cloning kubestellar/hive (branch v2) -> ${HIVE_SRC_DIR}..."
        git clone --quiet -b v2 https://github.com/kubestellar/hive "$HIVE_SRC_DIR"
      fi
      echo "Running upstream: just contribute-setup ${TOOL}"
      ( cd "$HIVE_SRC_DIR" && just contribute-setup "$TOOL" )
      [[ -f "$HIVE_CONTRIBUTOR_ENV" ]] || { echo "ERROR: contribute-setup ran but ${HIVE_CONTRIBUTOR_ENV} still missing." >&2; exit 1; }
      echo "✓ Upstream contribute-setup complete."
    fi

    # ── 2. Write the quadlet unit + selected tool fragment (write-if-changed) ──
    write_if_changed() {
      local dst="$1" content="$2"
      if [[ ! -f "$dst" ]] || [[ "$(cat "$dst")" != "$content" ]]; then
        printf '%s\n' "$content" > "$dst"
        echo "Wrote $(basename "$dst")"
      fi
    }
    write_if_changed "${CONF_DIR}/donate-clanker.container" "{{donate_clanker_unit}}"
    find "${DROPIN_DIR}" -maxdepth 1 -name '10-tool.conf' -delete
    tool_fragment_conf "$TOOL" > "${DROPIN_DIR}/10-tool.conf"
    while IFS= read -r d; do
      [[ -n "$d" ]] && mkdir -p "$d"
    done < <(tool_host_dirs "$TOOL")

    # ── 3. Resolve CLANKER_SRC into a stable workspace symlink ──
    is_git_url() { [[ "$1" =~ ^(https?|ssh|git)://.* || "$1" =~ ^git@.* ]]; }
    if [[ -z "$CLANKER_SRC" ]]; then
      if git -C "$INVOKED_DIR" rev-parse --is-inside-work-tree &>/dev/null; then
        CLANKER_SRC="$INVOKED_DIR"
        echo "CLANKER_SRC not set — defaulting to current repo: ${CLANKER_SRC}"
      elif [[ -L "$WORKSPACE" || -d "$WORKSPACE" ]]; then
        echo "CLANKER_SRC not set — reusing existing workspace at ${WORKSPACE}"
      else
        echo "ERROR: CLANKER_SRC not set and no prior workspace exists." >&2
        echo "  Run from a git repo, or: CLANKER_SRC=<path-or-git-url> ujust donate-clanker" >&2
        exit 1
      fi
    fi
    if [[ -n "$CLANKER_SRC" ]]; then
      if is_git_url "$CLANKER_SRC"; then
        slug="$(basename "${CLANKER_SRC%.git}")"
        clone_dir="${CLONES_DIR}/${slug}"
        if [[ -d "${clone_dir}/.git" ]]; then
          git -C "$clone_dir" pull --ff-only --quiet || echo "WARNING: pull failed, using existing checkout"
        else
          git clone --quiet "$CLANKER_SRC" "$clone_dir"
        fi
        target="$clone_dir"
      else
        target="$(realpath "$CLANKER_SRC")"
        [[ -d "$target" ]] || { echo "ERROR: CLANKER_SRC path does not exist: ${target}" >&2; exit 1; }
      fi
      rm -f "$WORKSPACE"
      ln -s "$target" "$WORKSPACE"
      echo "Workspace -> ${target}"
    fi

    # ── 4. Env files (created once, never overwritten again) ──
    if [[ ! -f "${CFG_DIR}/contributor.env" ]]; then
      printf '# HIVE_HUB=wss://your-hive.example.com/contribute\n' > "${CFG_DIR}/contributor.env"
    fi
    touch "${CFG_DIR}/secrets.env"; chmod 600 "${CFG_DIR}/secrets.env"
    # Re-derive secrets.env from this run's choices every time (never
    # additive) — provider/model selection is meant to be re-visitable on
    # each foreground run, not silently stuck from a prior one.
    grep -v -E '^(GOOSE_PROVIDER|GOOSE_MODEL|AGENT_MODEL|GH_TOKEN)=' "${CFG_DIR}/secrets.env" > "${CFG_DIR}/secrets.env.tmp" 2>/dev/null || true
    mv "${CFG_DIR}/secrets.env.tmp" "${CFG_DIR}/secrets.env"
    [[ -n "$AGENT_MODEL" ]] && echo "AGENT_MODEL=${AGENT_MODEL}" >> "${CFG_DIR}/secrets.env"
    if [[ "$TOOL" == "goose" ]]; then
      [[ -n "$GOOSE_PROVIDER" ]] && echo "GOOSE_PROVIDER=${GOOSE_PROVIDER}" >> "${CFG_DIR}/secrets.env"
      [[ -n "$GOOSE_MODEL" ]] && echo "GOOSE_MODEL=${GOOSE_MODEL}" >> "${CFG_DIR}/secrets.env"
    fi
    # Upstream contributor-agent.sh needs GH_TOKEN regardless of
    # AGENT_BACKEND — it's the contributor's personal token for the
    # fork+push credential helper, independent of which CLI drives the
    # actual coding. Re-derived every run from the host's gh session.
    if command -v gh &>/dev/null; then
      GH_TOKEN_VAL="$(gh auth token 2>/dev/null || true)"
      [[ -n "$GH_TOKEN_VAL" ]] && echo "GH_TOKEN=${GH_TOKEN_VAL}" >> "${CFG_DIR}/secrets.env"
    fi
    if ! grep -q '^GH_TOKEN=' "${CFG_DIR}/secrets.env"; then
      echo "WARNING: no GH_TOKEN available — the contributor agent needs it to push commits." >&2
      echo "  Run: gh auth login --web --scopes repo,read:org" >&2
    fi
    chmod 600 "${CFG_DIR}/secrets.env"

    systemctl --user daemon-reload
    if ! systemctl --user cat donate-clanker.service &>/dev/null; then
      echo "ERROR: quadlet did not generate donate-clanker.service. Run:" >&2
      echo "  /usr/lib/systemd/user-generators/podman-user-generator --dryrun" >&2
      exit 1
    fi

    # Foreground-equivalent: start, follow logs in *this* terminal, always
    # stop again on exit — Ctrl-C, normal exit, or an unexpected kill all
    # hit the same trap.
    cleanup() { echo ""; echo "Stopping donate-clanker..."; systemctl --user stop donate-clanker.service >/dev/null 2>&1 || true; }
    trap cleanup EXIT INT TERM

    systemctl --user start donate-clanker.service
    echo "✓ donate-clanker is running and consuming your ${TOOL} tokens."
    echo "  Stop any time with Ctrl-C, or: ujust donate-clanker-stop"
    echo ""
    journalctl --user -u donate-clanker.service -f --no-hostname &
    JPID=$!
    while systemctl --user is-active --quiet donate-clanker.service; do sleep 2; done
    kill "$JPID" 2>/dev/null || true

# Preflight check: is this machine actually ready for 'ujust donate-clanker'?
# Never starts the container — read-only diagnostics only.
donate-clanker-doctor:
    #!/usr/bin/env bash
    set -uo pipefail
    {{shared_functions}}
    TOOL_ORDER="{{tool_order}}"
    INVOKED_DIR="{{invocation_directory()}}"
    pass=0; fail=0
    check() {
      local label="$1"; shift
      if "$@" &>/dev/null; then echo "  ✓ ${label}"; pass=$((pass+1));
      else echo "  ✗ ${label}"; fail=$((fail+1)); fi
    }

    echo "=== Runtime ==="
    check "podman installed" command -v podman
    check "podman rootless works (podman info)" podman info
    check "quadlet generator present" test -x /usr/lib/systemd/system-generators/podman-system-generator
    check "user systemd instance reachable" systemctl --user status
    check "gum installed (needed to pick between multiple ready CLIs)" command -v gum
    echo ""

    echo "=== Upstream hive setup ==="
    check "gh installed" command -v gh
    check "gh authenticated" gh auth status
    check "contribute-setup completed (~/.config/hive/contributor.env)" test -f "${HOME}/.config/hive/contributor.env"
    echo ""

    echo "=== CLI backends ==="
    ready_tools=()
    for t in ${TOOL_ORDER}; do
      if tool_installed "$t"; then
        if tool_authenticated "$t"; then
          echo "  ✓ ${t}: installed + authenticated"
          ready_tools+=("$t")
        else
          echo "  ~ ${t}: installed, NOT authenticated — $(tool_fixit_hint "$t")"
        fi
      else
        echo "  ✗ ${t}: not installed — $(tool_install_hint "$t")"
      fi
    done
    echo ""

    case "${#ready_tools[@]}" in
      0) echo "No CLI is both installed and authenticated yet — TOOL auto-detect would fail." ;;
      1) echo "TOOL would auto-detect to: ${ready_tools[0]}" ;;
      *) echo "Multiple CLIs are ready (${ready_tools[*]}) — you'll be prompted to pick one via gum." ;;
    esac
    echo ""

    echo "=== Source (CLANKER_SRC) ==="
    WORKSPACE="${HOME}/.local/state/donate-clanker/workspace"
    if [[ -n "${CLANKER_SRC:-}" ]]; then
      echo "  CLANKER_SRC is set: ${CLANKER_SRC}"
    elif git -C "$INVOKED_DIR" rev-parse --is-inside-work-tree &>/dev/null; then
      echo "  CLANKER_SRC not set — current directory is a git repo, would default to: ${INVOKED_DIR}"
    elif [[ -L "$WORKSPACE" ]]; then
      echo "  CLANKER_SRC not set — would reuse existing workspace: $(readlink -f "$WORKSPACE" 2>/dev/null || echo "$WORKSPACE")"
    else
      echo "  ✗ CLANKER_SRC not set, current directory isn't a git repo, and no prior workspace exists."
      echo "    First run will fail unless you either 'cd' into the repo you want to donate against,"
      echo "    or run: CLANKER_SRC=<path-or-git-url> ujust donate-clanker"
    fi
    echo ""
    echo "${pass} checks passed, ${fail} failed."
    [[ "$fail" -eq 0 ]] || exit 1

# Safety net: stop and fully clean up donate-clanker, whether or not it's
# currently tracked as running. Recovers from a closed terminal / crashed
# shell that left the unit or container behind.
donate-clanker-stop:
    #!/usr/bin/env bash
    set -euo pipefail
    systemctl --user stop donate-clanker.service >/dev/null 2>&1 || true
    systemctl --user reset-failed donate-clanker.service >/dev/null 2>&1 || true
    podman rm -f donate-clanker >/dev/null 2>&1 || true
    echo "donate-clanker stopped and cleaned up."
    echo "Current state:"
    systemctl --user is-active donate-clanker.service 2>&1 || true
    podman ps -a --filter name=donate-clanker --format '  {{{{.Names}}}}\t{{{{.Status}}}}'
