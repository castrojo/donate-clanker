{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skills Index",
  "description": "Machine-readable catalog of skills in docs/skills/.",
  "type": "object",
  "required": ["schema_version", "generated_at", "skills"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Catalog schema version (semver major.minor)."
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 date the catalog was last updated (YYYY-MM-DD)."
    },
    "skills": {
      "type": "array",
      "description": "Ordered list of skill entries.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "one_line_purpose",
          "entry_point",
          "category",
          "status",
          "tags",
          "description",
          "version",
          "last_updated",
          "doc_type"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier matching the skill filename stem."
          },
          "name": {
            "type": "string",
            "description": "Display name, equal to the id."
          },
          "one_line_purpose": {
            "type": "string",
            "description": "One-sentence purpose shown in routing tables."
          },
          "entry_point": {
            "type": "string",
            "description": "Relative path to the skill document from repo root."
          },
          "category": {
            "type": "string",
            "enum": ["ci-ops", "test-authoring", "meta"],
            "description": "Skill category."
          },
          "status": {
            "type": "string",
            "enum": ["active", "deprecated", "reserved"],
            "description": "Lifecycle status."
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 3,
            "maxItems": 6,
            "description": "Lowercase keyword tags."
          },
          "description": {
            "type": "string",
            "maxLength": 256,
            "description": "Routing description shown in catalogs."
          },
          "version": {
            "type": "string",
            "description": "Skill document version string."
          },
          "last_updated": {
            "type": "string",
            "description": "ISO 8601 date the skill was last updated (YYYY-MM-DD)."
          },
          "doc_type": {
            "type": "string",
            "enum": ["policy", "reference", "runbook", "procedure"],
            "description": "Document type."
          }
        }
      }
    }
  }
}
