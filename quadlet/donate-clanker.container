# donate-clanker.container — Podman Quadlet for the KubeStellar Hive
# contributor workload (`ghcr.io/kubestellar/hive-contributor:latest`).
#
# Installed to: ~/.config/containers/systemd/donate-clanker.container
# Managed by:   podman-systemd.unit(5) via the user systemd instance
#
# This unit is started/stopped explicitly by `ujust donate-clanker` /
# `ujust donate-clanker-stop`. It is never enabled and never targets boot —
# see the note above the (deliberately absent) [Install] section below.

[Unit]
Description=Donate a Clanker — Hive contributor workload (foreground only)
# No Wants=/After=default.target: this unit must never be pulled in by a
# normal boot/login target. It only exists while explicitly started.

[Container]
Image=ghcr.io/kubestellar/hive-contributor:latest
ContainerName=donate-clanker

# Rootless UID mapping so the container's `dev` user can read the mounted
# host config dirs — the quadlet equivalent of `podman run --userns=keep-id`
# used in the upstream `just contribute-hive` recipe.
UserNS=keep-id

# ASSUMPTION: upstream's own containerized flow uses `--network host`
# (kubestellar/hive Justfile, contribute-hive recipe). The page/Justfile
# don't explain why host networking is required — the relay only makes an
# outbound WebSocket connection to HIVE_HUB, which works fine on the default
# rootless (pasta) network. We default to the sandboxed rootless network
# here as the more conventional/secure choice and only fall back to host
# networking if you hit connectivity issues (e.g. a local LiteLLM/Ollama
# endpoint that isn't reachable via host.containers.internal). To match
# upstream exactly, uncomment the next line via a drop-in instead of editing
# this file directly.
# Network=host

# Read-only: upstream hive contributor config written by
# `just contribute-setup <cli>` (registration token, backend, GH token).
Volume=%h/.config/hive:/home/dev/.config/hive:ro,Z
Volume=%h/.config/gh:/home/dev/.config/gh:ro,Z

# Workspace: always a single, stable host path. The bootstrap script
# (bin/donate-clanker-bootstrap.sh) resolves CLANKER_SRC into this path on
# every run — either a symlink to a local directory, or a persistent clone
# of a Git URL. Podman resolves host-side symlinks at mount time, so this
# works for both cases without changing the unit file.
#
# ASSUMPTION: the upstream hive-contributor image doesn't define a
# "workspace" concept of its own — the hub assigns tasks/repos dynamically
# over the WebSocket relay, and the contributor container clones whatever
# it's told to. This mount is a convenience scratch/pre-seeded workspace for
# local testing per your requirements, not something the reference
# instructions describe. Confirm the container actually uses
# /home/dev/workspace before relying on it; adjust the target path if the
# image expects something else.
Volume=%h/.local/state/donate-clanker/workspace:/home/dev/workspace:Z

# CLI-specific config mounts (e.g. ~/.claude, ~/.copilot) are supplied by a
# single generated drop-in fragment, not hardcoded here — see
# quadlet/tools/*.conf and the TOOL= variable in just/61-donate-clanker.just.

EnvironmentFile=%h/.config/donate-clanker/contributor.env
# Always created (empty by default) by the bootstrap script, so this can be a
# plain EnvironmentFile= — quadlet's key doesn't support systemd's "-optional"
# prefix (podman-systemd.unit(5) only accepts absolute or unit-relative paths).
EnvironmentFile=%h/.config/donate-clanker/secrets.env

[Service]
# Give the CLI/relay a moment to shut down cleanly on stop instead of being
# killed outright.
TimeoutStopSec=20

# Intentionally NO [Install] section.
#
# A normal quadlet would put `WantedBy=default.target` here so the unit
# starts automatically at login/boot. We deliberately omit it: this
# workload consumes API tokens for as long as it runs, so it must only ever
# be active because a human just typed `ujust donate-clanker` in a terminal
# they're watching — never because systemd decided to start it on their
# behalf. Do not add an [Install] section or run
# `systemctl --user enable donate-clanker.service`.
