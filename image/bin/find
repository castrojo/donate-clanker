#!/usr/bin/env python3
"""Provide the small find subset used by contributor exploration."""

import os
import sys


def main(args: list[str]) -> int:
    root = "."
    if args and not args[0].startswith("-"):
        root = args.pop(0)
    depth = None
    kinds: set[str] = set()
    while args:
        option = args.pop(0)
        if option == "-maxdepth" and args:
            depth = int(args.pop(0))
        elif option == "-type" and args:
            kinds.add(args.pop(0))
        elif option == "-o":
            continue
        else:
            print(f"find: unsupported option: {option}", file=sys.stderr)
            return 1
    for directory, directories, files in os.walk(root):
        relative = os.path.relpath(directory, root)
        relative_depth = 0 if relative == "." else len(relative.split(os.sep))
        if depth is not None and relative_depth >= depth:
            directories[:] = []
        if not kinds or "d" in kinds:
            print(directory)
        if depth is None or relative_depth < depth:
            for name in files:
                if not kinds or "f" in kinds:
                    print(os.path.join(directory, name))
    return 0


raise SystemExit(main(sys.argv[1:]))
