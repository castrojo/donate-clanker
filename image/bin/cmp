#!/usr/bin/env python3
"""Provide the cmp -s form used by Hive's knowledge refresh loop."""

import sys


def files_match(left: str, right: str) -> bool:
    with open(left, "rb") as left_file, open(right, "rb") as right_file:
        while True:
            if left_file.read(65536) != right_file.read(65536):
                return False
            if left_file.tell() == left_file.seek(0, 2):
                return True


if sys.argv[1:] and sys.argv[1] == "-s":
    sys.argv.pop(1)

if len(sys.argv) != 3:
    sys.exit(2)

try:
    sys.exit(0 if files_match(sys.argv[1], sys.argv[2]) else 1)
except OSError:
    sys.exit(2)
