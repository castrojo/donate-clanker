#!/usr/bin/env bash
# Conventional Commits check.
#
# The squash commit subject on a pull request is inherited from the PR TITLE,
# not from any individual commit, so this hook cannot guarantee the merged
# history. It exists to build the habit and to keep single-commit branches
# tidy. The authoritative check is the pr-title workflow.
set -uo pipefail

message_file="${1:?commit-msg hook requires a message file}"
subject="$(head -n 1 "$message_file")"

# Ignore the messages git generates for merges, reverts, fixups and squashes.
case "$subject" in
"Merge "* | "Revert "* | "fixup!"* | "squash!"* | "Reapply "*) exit 0 ;;
esac

# Allow an empty message through so git's own "aborting commit" path reports it.
[ -z "${subject// /}" ] && exit 0

pattern='^(feat|fix|chore|docs|style|refactor|perf|test|ci|build|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
	cat >&2 <<-EOF
		commit-msg: subject is not a Conventional Commit.

		  got:  ${subject}
		  want: <type>[optional scope]: <description>

		  types: feat fix chore docs style refactor perf test ci build revert
		  e.g.:  fix(launcher): keep qemu in the foreground

		Bypass with --no-verify; the PR title is what actually gates merging.
	EOF
	exit 1
fi

if [ "${#subject}" -gt 72 ]; then
	printf 'commit-msg: subject is %d characters; keep it under 72\n' "${#subject}" >&2
	exit 1
fi
exit 0
