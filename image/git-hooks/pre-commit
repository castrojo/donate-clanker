#!/usr/bin/env bash
# donate-clanker pre-commit hook.
#
# Installed for every repository via a global core.hooksPath, so it runs inside
# repositories it knows nothing about. It must therefore be fast, idempotent and
# tolerant of missing tools and unfamiliar layouts.
#
# This hook is ERGONOMICS, NOT ENFORCEMENT. `git commit --no-verify` bypasses
# it, and an agent can pass that flag as easily as a human. Anything that must
# hold is a required status check on the pull request.
set -uo pipefail

fail=0
note() { printf 'pre-commit: %s\n' "$1" >&2; }

staged() { git diff --cached --name-only --diff-filter=ACM -z; }

# Whitespace errors and conflict markers are cheap to catch and always wrong.
if ! git diff --cached --check; then
	note 'whitespace errors above; fix them or stage the corrected file'
	fail=1
fi

while IFS= read -r -d '' file; do
	case "$file" in
	*.go)
		if command -v gofmt >/dev/null 2>&1 && [ -n "$(gofmt -l "$file" 2>/dev/null)" ]; then
			note "gofmt: $file is not formatted (run: gofmt -w $file)"
			fail=1
		fi
		;;
	*.sh)
		if command -v shellcheck >/dev/null 2>&1 && ! shellcheck --severity=error "$file"; then
			note "shellcheck: $file has errors"
			fail=1
		fi
		;;
	*.json)
		if command -v python3 >/dev/null 2>&1 &&
			! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$file" 2>/dev/null; then
			note "invalid JSON: $file"
			fail=1
		fi
		;;
	esac

	# Generated Goose skill projections are never committed. They are produced
	# from docs/skills/index.json and belong only to the running container.
	case "$file" in
	.agents/skills/*)
		note "refusing to commit generated skill projection: $file"
		fail=1
		;;
	esac
done < <(staged)

if [ "$fail" -ne 0 ]; then
	note 'commit rejected (bypass with --no-verify, but CI will still check)'
fi
exit "$fail"
