#!/usr/bin/env bash
# Runs after `git clone` and after every checkout.
#
# Hive does not clone anything before launching the agent: the fixed task prompt
# tells the agent to fork and clone the repository itself. This hook is
# therefore the only reliable moment at which donate-clanker sees a fresh
# working tree, so it is where per-repository setup happens.
#
# It must stay fast and silent in repositories that know nothing about
# projectbluefin.
set -uo pipefail

# Arguments are: <prev-head> <new-head> <branch-checkout-flag>. Only a branch
# checkout (1) is interesting; file checkouts (0) fire constantly.
[ "${3:-1}" = "1" ] || exit 0

git_dir="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

exclude_file="${git_dir}/info/exclude"
mkdir -p "$(dirname "$exclude_file")" 2>/dev/null || exit 0

# Keep generated skill projections out of `git status` and therefore out of any
# commit the agent makes. This is repository-local and never committed itself.
for pattern in '/.agents/skills/' '/.goose/skills/'; do
	if ! grep -qxF "$pattern" "$exclude_file" 2>/dev/null; then
		printf '%s\n' "$pattern" >>"$exclude_file" 2>/dev/null || true
	fi
done

# Surface the repository's own skills so the agent knows they exist. Goose
# discovers skills at session start in /home/dev, long before this clone
# existed, so these can never be registered natively -- reading the manifest is
# the supported path.
if [ -f "${toplevel}/docs/skills/index.json" ]; then
	printf 'donate-clanker: %s has repository skills; read docs/skills/index.json and open only the matching entry_point.\n' \
		"$(basename "$toplevel")" >&2
fi

exit 0
